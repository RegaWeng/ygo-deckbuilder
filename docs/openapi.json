{
    "openapi": "3.0.0",
    "info": {
      "title": "YGO Deck Builder API",
      "version": "1.0.0",
      "description": "Deck-building API combining PostgreSQL (users/decks) and MongoDB (card catalog)"
    },
    "servers": [{ "url": "http://localhost:3000" }],
    "components": {
      "securitySchemes": {
        "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
      }
    },
    "paths": {
      "/register": {
        "post": {
          "summary": "Create a new account",
          "requestBody": { "content": { "application/json": { "example": { "username": "string", "password": "string", "email": "string" } } } },
          "responses": { "201": { "description": "Account created" }, "400": { "description": "Validation error" } }
        }
      },
      "/login": {
        "post": {
          "summary": "Authenticate and receive a JWT",
          "requestBody": { "content": { "application/json": { "example": { "username": "string", "password": "string" } } } },
          "responses": { "200": { "description": "Returns token" }, "401": { "description": "Invalid credentials" } }
        }
      },
      "/change-password": {
        "put": {
          "summary": "Change password (logged in)",
          "security": [{ "bearerAuth": [] }],
          "requestBody": { "content": { "application/json": { "example": { "currentPassword": "string", "newPassword": "string" } } } },
          "responses": { "200": { "description": "Password updated" }, "401": { "description": "Current password incorrect" } }
        }
      },
      "/request-password-reset": {
        "post": {
          "summary": "Request a password reset token",
          "requestBody": { "content": { "application/json": { "example": { "email": "string" } } } },
          "responses": { "200": { "description": "Token issued (mocked email delivery)" } }
        }
      },
      "/reset-password": {
        "post": {
          "summary": "Reset password using a token",
          "requestBody": { "content": { "application/json": { "example": { "reset_token": "string", "newPassword": "string" } } } },
          "responses": { "200": { "description": "Password reset" }, "400": { "description": "Invalid or expired token" } }
        }
      },
      "/me": {
        "get": {
          "summary": "Get current user's profile",
          "security": [{ "bearerAuth": [] }],
          "responses": { "200": { "description": "User profile" } }
        },
        "delete": {
          "summary": "Delete own account",
          "security": [{ "bearerAuth": [] }],
          "responses": { "204": { "description": "Deleted" }, "400": { "description": "Admins cannot self-delete" } }
        }
      },
      "/decks": {
        "get": {
          "summary": "List current user's decks",
          "security": [{ "bearerAuth": [] }],
          "responses": { "200": { "description": "Array of decks" } }
        },
        "post": {
          "summary": "Create a deck",
          "security": [{ "bearerAuth": [] }],
          "requestBody": { "content": { "application/json": { "example": { "deck_name": "string", "format": "TCG" } } } },
          "responses": { "201": { "description": "Deck created" } }
        }
      },
      "/decks/{id}": {
        "get": {
          "summary": "Get a deck with its cards (joins Postgres + MongoDB)",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "responses": { "200": { "description": "Deck with cards and validation status" }, "404": { "description": "Not found" } }
        },
        "put": {
          "summary": "Replace deck fields",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "responses": { "200": { "description": "Updated" }, "404": { "description": "Not found" } }
        },
        "patch": {
          "summary": "Partially update deck fields",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "responses": { "200": { "description": "Updated" }, "404": { "description": "Not found" } }
        },
        "delete": {
          "summary": "Delete a deck",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } }
        }
      },
      "/decks/{id}/cards": {
        "post": {
          "summary": "Add a card to a deck (validated against MongoDB, triggers async RabbitMQ validation)",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "requestBody": { "content": { "application/json": { "example": { "card_id": 12345678, "section": "main", "quantity": 1 } } } },
          "responses": { "201": { "description": "Card added" }, "409": { "description": "Would exceed 3-copy limit" }, "400": { "description": "Invalid card_id" } }
        }
      },
      "/decks/{id}/cards/{cardId}": {
        "delete": {
          "summary": "Remove a card from a deck",
          "security": [{ "bearerAuth": [] }],
          "parameters": [
            { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
            { "name": "cardId", "in": "path", "required": true, "schema": { "type": "string" } }
          ],
          "requestBody": { "content": { "application/json": { "example": { "section": "main" } } } },
          "responses": { "204": { "description": "Removed" }, "404": { "description": "Not found" } }
        }
      },
      "/cards/search": {
        "get": {
          "summary": "Search the card catalog by name (partial match)",
          "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }],
          "responses": { "200": { "description": "Array of matching cards" } }
        }
      },
      "/cards/{id}": {
        "get": {
          "summary": "Get a single card by ID",
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "responses": { "200": { "description": "Card details" }, "404": { "description": "Not found" } }
        }
      },
      "/users": {
        "get": {
          "summary": "List all users (super_admin only)",
          "security": [{ "bearerAuth": [] }],
          "responses": { "200": { "description": "Array of users" }, "403": { "description": "Insufficient permissions" } }
        }
      },
      "/users/{id}/role": {
        "put": {
          "summary": "Change a user's role (super_admin only)",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "requestBody": { "content": { "application/json": { "example": { "role": "worker" } } } },
          "responses": { "200": { "description": "Role updated" }, "400": { "description": "Cannot modify own account" } }
        }
      },
      "/users/{id}": {
        "delete": {
          "summary": "Delete a user (super_admin only)",
          "security": [{ "bearerAuth": [] }],
          "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
          "responses": { "204": { "description": "Deleted" }, "400": { "description": "Cannot delete own account" } }
        }
      },
      "/health": {
        "get": {
          "summary": "Check API and dependency status",
          "responses": { "200": { "description": "All dependencies healthy" }, "503": { "description": "A dependency is down" } }
        }
      }
    }
  }